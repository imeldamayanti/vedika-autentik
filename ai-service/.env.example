AI_SERVICE_KEY=
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Phone helper (station laptop only; docs/rencana-v3-otomatis/STASIUN.md) ---
# 1 = drive the Android phone over adb, palsu = in-memory fake phone (tests, e2e). Empty = routes do not exist.
SALURAN_ADB=
# adb binary; default "adb" from PATH.
SALURAN_ADB_BIN=
# Device serial from `adb devices`; required only when several devices are attached.
SALURAN_ADB_SERIAL=
# Backend URL the agent page calls (default http://localhost:8000).
SALURAN_API_URL=
# Same value as AGEN_KEY in backend/.env; reaches the station browser only through the localhost-only config route.
SALURAN_AGEN_KEY=
# speaker (default: phone on speakerphone, Chrome echo cancellation on) or kabel (USB audio interface, processing off).
SALURAN_AUDIO=speaker
# Substring of the Chrome input / output device label; empty = system default.
SALURAN_INPUT=
SALURAN_OUTPUT=
