# Salin ke .env lalu isi. JANGAN commit .env.
DATABASE_URL=postgresql://postgres.bhcvyxptrdlkslwtjoiw:GANTI_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://bhcvyxptrdlkslwtjoiw.supabase.co
SUPABASE_SERVICE_KEY=GANTI_SERVICE_ROLE_KEY
MESIN_URL=http://localhost:8001

# --- v3: konfirmasi suara (docs/api-contract-v3.md) ---
# Kunci agen suara untuk header X-Kunci-Agen. Kosong = semua endpoint agen menolak (401).
AGEN_KEY=GANTI_KUNCI_AGEN
# Kunci API -> pembaca jawaban (header X-Kunci-Layanan); sama dengan AI_SERVICE_KEY di ai-service. Kosong = tanpa kunci (stub).
KUNCI_MESIN=
# Prototipe: semua panggilan dan WA menuju satu nomor penguji (R2.1), bukan nomor peserta. Awalan 0800 tidak bisa ditelepon.
NOMOR_PENGUJI=0800-0000-0000
# Nomor SIM di HP saluran; disebut di pesan WA supaya penerima mengenali penelepon.
NOMOR_PENELEPON=0800-0000-0165
# Origin FE yang boleh memanggil API langsung, termasuk halaman agen di laptop stasiun (http://localhost:8001).
CORS_ORIGINS=http://localhost:8899,http://127.0.0.1:8899,http://localhost:8001

# --- WhatsApp lewat Meta Cloud API (app/wa.py; docs/rencana-v3-otomatis/STASIUN.md) ---
# log = tidak mengirim apa pun (tercatat "simulasi"); teks = pesan teks (hanya dalam 24 jam setelah penerima mengirim
# pesan ke nomor bisnis); template = template yang disetujui Meta. Tanpa token atau phone id selalu log.
META_WA_MODE=log
META_WA_TOKEN=
META_WA_PHONE_ID=
# Wajib di mode teks dan template: versi Graph API yang tampil di dasbor aplikasi Meta (mis. v2x.0). Tidak ada bawaan.
META_WA_API_VERSION=
META_WA_TEMPLATE_PEMBERITAHUAN=
META_WA_TEMPLATE_CADANGAN=
META_WA_TEMPLATE_BAHASA=id
