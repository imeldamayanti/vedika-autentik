# Salin ke .env lalu isi. JANGAN commit .env.
DATABASE_URL=postgresql://postgres.bhcvyxptrdlkslwtjoiw:GANTI_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://bhcvyxptrdlkslwtjoiw.supabase.co
SUPABASE_SERVICE_KEY=GANTI_SERVICE_ROLE_KEY
MESIN_URL=http://localhost:8001

# --- v3: konfirmasi suara (docs/api-contract-v3.md) ---
# Kunci agen suara untuk header X-Kunci-Agen. Kosong = semua endpoint agen menolak (401).
AGEN_KEY=GANTI_KUNCI_AGEN
# Kunci API -> pembaca jawaban (header X-Kunci-Layanan); sama dengan AI_SERVICE_KEY di ai-service. Kosong = tanpa kunci (stub).
KUNCI_MESIN=
# Prototipe: semua panggilan dan WA menuju satu nomor penguji (R2.1), bukan nomor peserta. Awalan 0800 tidak bisa ditelepon.
NOMOR_PENGUJI=0800-0000-0000
NOMOR_PENELEPON=0800-0000-0165
# Origin FE yang boleh memanggil API langsung; tambahkan origin halaman agen (mis. http://localhost:5173).
CORS_ORIGINS=http://localhost:8899,http://127.0.0.1:8899
